--- /dev/null
+++ b/src/main/java/net/venomous/meteoraddon/utils/MovementMath.java
@@ -0,0 +1,103 @@
+package net.venomous.meteoraddon.utils;
+
+/**
+ * Pure movement math shared by the movement modules.
+ *
+ * <p>Deliberately free of any Minecraft types so the logic can be unit tested on a plain JVM.
+ * All angles are in Minecraft yaw degrees (0 = +Z, 90 = -X).</p>
+ */
+public final class MovementMath {
+   /** Vanilla walking speed of a sprinting player on flat ground, in blocks/tick. */
+   public static final double SPRINT_SPEED = 0.2873;
+   /** Vanilla walking speed of a non-sprinting player on flat ground, in blocks/tick. */
+   public static final double WALK_SPEED = 0.2158;
+
+   private MovementMath() {
+   }
+
+   /**
+    * Vanilla-accurate horizontal velocity for the given input.
+    *
+    * <p>Unlike the old ad-hoc angle juggling, this uses the same normalised
+    * forward/strafe rotation the vanilla client uses, so diagonal movement is not
+    * faster than straight movement — a very common reason anticheats flag
+    * "Speed (Prediction)".</p>
+    *
+    * @param yaw    player yaw in degrees
+    * @param fwd    forward input, -1..1
+    * @param str    strafe input, -1..1 (positive = left, matching vanilla key presses)
+    * @param speed  desired horizontal speed in blocks/tick
+    * @return {velocityX, velocityZ}; {0,0} when there is no input
+    */
+   public static double[] velocity(double yaw, double fwd, double str, double speed) {
+      double length = Math.sqrt(fwd * fwd + str * str);
+      if (length < 1.0E-6 || speed <= 0.0) {
+         return new double[] {0.0, 0.0};
+      }
+
+      // Normalise so diagonals are not sqrt(2) faster than cardinals.
+      fwd /= length;
+      str /= length;
+
+      double rad = Math.toRadians(yaw);
+      double sin = Math.sin(rad);
+      double cos = Math.cos(rad);
+
+      double x = (str * cos - fwd * sin) * speed;
+      double z = (fwd * cos + str * sin) * speed;
+      return new double[] {x, z};
+   }
+
+   /**
+    * Base horizontal move speed including potion effects.
+    *
+    * @param sprinting       whether the player is sprinting
+    * @param speedAmplifier  Speed effect amplifier, or -1 when the effect is absent
+    * @param slowAmplifier   Slowness effect amplifier, or -1 when the effect is absent
+    */
+   public static double baseSpeed(boolean sprinting, int speedAmplifier, int slowAmplifier) {
+      double base = sprinting ? SPRINT_SPEED : WALK_SPEED;
+      if (speedAmplifier >= 0) {
+         base *= 1.0 + 0.2 * (speedAmplifier + 1);
+      }
+
+      if (slowAmplifier >= 0) {
+         base *= Math.max(0.0, 1.0 - 0.15 * (slowAmplifier + 1));
+      }
+
+      return base;
+   }
+
+   /**
+    * Vertical motion for a "hover" style flight that mimics falling/landing so that
+    * prediction based checks (Vulcan's {@code Flight (Hover)} / {@code Flight (Prediction)})
+    * keep seeing gravity being applied.
+    *
+    * @param tick         monotonically increasing tick counter
+    * @param period       how often a downward pulse is emitted, in ticks
+    * @param pulseMotion  downward motion applied during a pulse (negative)
+    * @param up           whether the player requests going up
+    * @param down         whether the player requests going down
+    * @param vertical     requested vertical speed
+    */
+   public static double verticalMotion(int tick, int period, double pulseMotion, boolean up, boolean down, double vertical) {
+      if (up) {
+         return vertical;
+      }
+
+      if (down) {
+         return -vertical;
+      }
+
+      if (period <= 0) {
+         return 0.0;
+      }
+
+      return tick % period == 0 ? pulseMotion : 0.0;
+   }
+
+   /** Clamps a value into the inclusive range. */
+   public static double clamp(double value, double min, double max) {
+      return value < min ? min : Math.min(value, max);
+   }
+}
diff --git a/src/test/java/net/venomous/meteoraddon/MovementMathTest.java b/src/test/java/net/venomous/meteoraddon/MovementMathTest.java
new file mode 100644
index 0000000..913d15b
--- /dev/null
+++ b/src/test/java/net/venomous/meteoraddon/MovementMathTest.java
@@ -0,0 +1,98 @@
+package net.venomous.meteoraddon;
+
+import net.venomous.meteoraddon.utils.MovementMath;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+public class MovementMathTest {
+
+    private static double length(double[] v) {
+        return Math.sqrt(v[0] * v[0] + v[1] * v[1]);
+    }
+
+    @Test
+    void noInputProducesNoMotion() {
+        double[] v = MovementMath.velocity(37.0, 0.0, 0.0, 0.5);
+        assertEquals(0.0, v[0]);
+        assertEquals(0.0, v[1]);
+    }
+
+    @Test
+    void diagonalIsNotFasterThanStraight() {
+        double speed = 0.2873;
+        double straight = length(MovementMath.velocity(0.0, 1.0, 0.0, speed));
+        double diagonal = length(MovementMath.velocity(0.0, 1.0, 1.0, speed));
+
+        assertEquals(speed, straight, 1e-9);
+        assertEquals(speed, diagonal, 1e-9, "Diagonal movement must be normalised, otherwise speed checks flag");
+    }
+
+    @Test
+    void forwardAtZeroYawMovesTowardsPositiveZ() {
+        double[] v = MovementMath.velocity(0.0, 1.0, 0.0, 1.0);
+        assertEquals(0.0, v[0], 1e-9);
+        assertEquals(1.0, v[1], 1e-9);
+    }
+
+    @Test
+    void forwardAtNinetyYawMovesTowardsNegativeX() {
+        double[] v = MovementMath.velocity(90.0, 1.0, 0.0, 1.0);
+        assertEquals(-1.0, v[0], 1e-9);
+        assertEquals(0.0, v[1], 1e-9);
+    }
+
+    @Test
+    void strafeIsPerpendicularToForward() {
+        double[] fwd = MovementMath.velocity(0.0, 1.0, 0.0, 1.0);
+        double[] left = MovementMath.velocity(0.0, 0.0, 1.0, 1.0);
+        double dot = fwd[0] * left[0] + fwd[1] * left[1];
+        assertEquals(0.0, dot, 1e-9);
+    }
+
+    @Test
+    void baseSpeedAppliesPotionEffects() {
+        assertEquals(MovementMath.SPRINT_SPEED, MovementMath.baseSpeed(true, -1, -1), 1e-9);
+        assertEquals(MovementMath.WALK_SPEED, MovementMath.baseSpeed(false, -1, -1), 1e-9);
+
+        // Speed II -> +40%
+        assertEquals(MovementMath.SPRINT_SPEED * 1.4, MovementMath.baseSpeed(true, 1, -1), 1e-9);
+        // Slowness I -> -15%
+        assertEquals(MovementMath.SPRINT_SPEED * 0.85, MovementMath.baseSpeed(true, -1, 0), 1e-9);
+        // Never negative, no matter how strong the slowness
+        assertTrue(MovementMath.baseSpeed(true, -1, 20) >= 0.0);
+    }
+
+    @Test
+    void verticalMotionPrefersExplicitInput() {
+        assertEquals(0.2, MovementMath.verticalMotion(3, 6, -0.08, true, false, 0.2), 1e-9);
+        assertEquals(-0.2, MovementMath.verticalMotion(3, 6, -0.08, false, true, 0.2), 1e-9);
+    }
+
+    @Test
+    void verticalMotionPulsesDownwardsPeriodically() {
+        int period = 6;
+        int pulses = 0;
+        for (int tick = 1; tick <= 60; tick++) {
+            double dy = MovementMath.verticalMotion(tick, period, -0.08, false, false, 0.2);
+            assertTrue(dy <= 0.0, "Idle hover must never drift upwards");
+            if (dy < 0.0) {
+                pulses++;
+            }
+        }
+
+        assertEquals(10, pulses, "Hover must emit a gravity pulse every period ticks");
+    }
+
+    @Test
+    void verticalMotionWithoutPeriodIsFlat() {
+        assertEquals(0.0, MovementMath.verticalMotion(7, 0, -0.08, false, false, 0.2), 1e-9);
+    }
+
+    @Test
+    void clampBoundsValues() {
+        assertEquals(1.0, MovementMath.clamp(5.0, 0.0, 1.0), 1e-9);
+        assertEquals(0.0, MovementMath.clamp(-5.0, 0.0, 1.0), 1e-9);
+        assertEquals(0.5, MovementMath.clamp(0.5, 0.0, 1.0), 1e-9);
+    }
+}
