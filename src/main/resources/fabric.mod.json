{
  "schemaVersion": 1,
  "id": "venomous",
  "version": "${version}",
  "name": "Venomous",
  "description": "Optimized & Refined Meteor Client addon for Minecraft 26.2.",
  "license": "GPL-3.0-or-later",
  "authors": [
    "International Duck Incorporated"
  ],
  "contact": {
    "sources": "https://gitlab.com/international-duck-incorporated/Venomous"
  },
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "net.venomous.meteoraddon.VenomousAddon"
    ]
  },
  "mixins": [
    "venomous.mixins.json"
  ],
  "icon": "assets/venomous/icon.png",
  "custom": {
    "meteor-client:color": "95,210,80",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=0.19.3",
    "meteor-client": "*"
  }
}
